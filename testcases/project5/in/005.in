int gcd(int a,int b){
    int r;
    while(b!=0){
        r=a%b;
        a=b;
        b=r;
    }
    return a;
}
int main0(){
    int a;
    int b;
    a=read();
    b=read();
    write(gcd(a,b));
    return 0;
}
